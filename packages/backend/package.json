{
  "name": "elys-pro-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/client.ts",
  "module": "src/client.ts",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "build": "bun run build.ts",
    "dbupdate": "bun prisma:migrate && bun prisma:generate",
    "prisma:studio": "bunx --bun prisma studio",
    "postinstall": "bun run postinstall.ts",
    "prisma:migrate": "bunx --bun prisma migrate dev --name",
    "prisma:generate": "bunx --bun prisma generate"
  },
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "elysia": "^1.4.21",
    "es-toolkit": "^1.43.0",
    "fdir": "^6.5.0",
    "fs-extra": "^11.3.3",
    "ky": "^1.14.2",
    "opendal": "^0.49.2",
    "pg": "^8.16.3",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "@types/pg": "^8.16.0",
    "@types/semver": "^7.7.1",
    "prisma": "^7.2.0",
    "prismabox": "^1.1.26"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
